{
  "name": "procxy",
  "version": "0.1.2",
  "description": "Type-safe process-based proxy for Node.js - Run class instances in isolated child processes with full TypeScript support",
  "keywords": [
    "proxy",
    "ipc",
    "child-process",
    "typescript",
    "process",
    "isolation",
    "worker",
    "eventemitter",
    "type-safe",
    "async",
    "rpc",
    "concurrency"
  ],
  "homepage": "https://pradeepmouli.github.io/procxy/",
  "bugs": {
    "url": "https://github.com/pradeepmouli/procxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pradeepmouli/procxy.git"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "docs:dev": "pnpm --filter procxy-docs dev",
    "docs:build": "pnpm --filter procxy-docs build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "simple-git-hooks",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "optionalDependencies": {
    "debug": "^4.4.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@to-skills/vitepress": "^0.2.26",
    "@types/node": "^26.0.1",    "@vitest/coverage-v8": "^4.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.66.0",
    "simple-git-hooks": "^2.13.1",
    "tinypool": "^2.1.0",
    "tsx": "^4.22.3",
    "type-fest": "^5.6.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-to-skills": "1.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}
