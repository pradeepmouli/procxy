{
  "name": "procxy",
  "version": "0.1.1",
  "description": "Type-safe process-based proxy for Node.js - Run class instances in isolated child processes with full TypeScript support",
  "keywords": [
    "proxy",
    "ipc",
    "child-process",
    "typescript",
    "process",
    "isolation",
    "worker",
    "eventemitter",
    "type-safe",
    "async",
    "rpc",
    "concurrency"
  ],
  "homepage": "https://github.com/pradeepmouli/procxy#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/procxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pradeepmouli/procxy.git"
  },
  "license": "MIT",
  "author": "Your Name <your.email@example.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "type-check": "tsgo --noEmit -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "simple-git-hooks",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "optionalDependencies": {
    "debug": "^4.4.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260313.1",
    "@vitest/coverage-v8": "^4.1.0",
    "lint-staged": "^16.3.3",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "simple-git-hooks": "^2.13.1",
    "tinypool": "^2.1.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.4",
    "typedoc": "^0.28.17",
    "typedoc-plugin-to-skills": "^0.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.6.2"
}
