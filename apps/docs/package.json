{
  "name": "procxy-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for procxy",
  "scripts": {
    "docs:api": "typedoc --options .vitepress/typedoc.json && node scripts/escape-api-md.mjs",
    "dev": "pnpm run docs:api && vitepress dev",
    "build": "pnpm run docs:api && vitepress build",
    "preview": "vitepress preview",
    "typecheck": "vitepress build --debug"
  },
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-skillit": "^2.0.4",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)"
}
